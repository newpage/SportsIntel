<VirtualHost *:80>
    ServerName sports.example.com
    Redirect permanent / https://sports.example.com/
</VirtualHost>

<VirtualHost *:443>
    ServerName sports.example.com
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/sports.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/sports.example.com/privkey.pem

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"
    LimitRequestBody 10485760
    ProxyTimeout 60

    <Location />
        AuthType Basic
        AuthName "SportsIntel Private Preview"
        AuthUserFile /etc/apache2/sportsintel-preview.htpasswd
        Require valid-user
    </Location>

    ProxyPass        /api/ http://127.0.0.1:8300/api/ timeout=60 retry=0
    ProxyPassReverse /api/ http://127.0.0.1:8300/api/
    ProxyPass        /health http://127.0.0.1:8300/health timeout=10 retry=0
    ProxyPassReverse /health http://127.0.0.1:8300/health
    ProxyPass        /_next/webpack-hmr ws://127.0.0.1:3300/_next/webpack-hmr
    ProxyPassReverse /_next/webpack-hmr ws://127.0.0.1:3300/_next/webpack-hmr
    ProxyPass        / http://127.0.0.1:3300/ timeout=60 retry=0
    ProxyPassReverse / http://127.0.0.1:3300/

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    ErrorLog ${APACHE_LOG_DIR}/sportsintel-error.log
    CustomLog ${APACHE_LOG_DIR}/sportsintel-access.log combined
</VirtualHost>
