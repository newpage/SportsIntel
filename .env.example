# Local development ports and frontend API origin.
API_PORT=8300
WEB_PORT=3300
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:8300

# Application runtime metadata and security controls.
SPORTSINTEL_ENV=development
SPORTSINTEL_VERSION=0.2.0
SPORTSINTEL_BUILD_TIMESTAMP=unknown
SPORTSINTEL_GIT_COMMIT=unknown
SPORTSINTEL_ADMIN_KEY=dev-only-admin-key-not-for-production-1234
SPORTSINTEL_CORS_ORIGINS=http://localhost:3300
SPORTSINTEL_PUBLIC_RATE_LIMIT=60
SPORTSINTEL_ADMIN_RATE_LIMIT=20
SPORTSINTEL_TRUST_PROXY_HEADERS=false

# Provider and local data configuration.
YAHOO_NFL_RSS_URL=https://sports.yahoo.com/nfl/rss/
PREDICTION_HISTORY_FILE=/app/data/prediction_history.json

# Snapshot persistence and PostgreSQL development credentials.
NFL_SNAPSHOT_STORE=postgres
DATABASE_URL=postgresql://sportsintel:change-me@postgres:5432/sportsintel
POSTGRES_DB=sportsintel
POSTGRES_USER=sportsintel
POSTGRES_PASSWORD=change-me
