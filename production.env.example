# Copy to a root-owned deployment environment file and replace every placeholder.
API_PORT=8300
WEB_PORT=3300
NEXT_PUBLIC_API_URL=https://sports.example.com
COMPOSE_PROJECT_NAME=sportsintel
SPORTSINTEL_DEPLOY_ROOT=/opt/sportsintel
SPORTSINTEL_PUBLIC_URL=https://sports.example.com
SPORTSINTEL_BACKUP_DIR=/opt/sportsintel/backups
SPORTSINTEL_BACKUP_RETENTION_DAYS=14

SPORTSINTEL_ENV=production
SPORTSINTEL_VERSION=0.2.0
SPORTSINTEL_BUILD_TIMESTAMP=replace-with-utc-iso-8601-timestamp
SPORTSINTEL_GIT_COMMIT=replace-with-deployed-git-commit
SPORTSINTEL_ADMIN_KEY=replace-with-cryptographically-random-32-plus-character-key
SPORTSINTEL_CORS_ORIGINS=https://sports.example.com
SPORTSINTEL_PUBLIC_RATE_LIMIT=60
SPORTSINTEL_ADMIN_RATE_LIMIT=20
SPORTSINTEL_TRUST_PROXY_HEADERS=true

YAHOO_NFL_RSS_URL=https://sports.yahoo.com/nfl/rss/
PREDICTION_HISTORY_FILE=/app/data/prediction_history.json

NFL_SNAPSHOT_STORE=postgres
DATABASE_URL=postgresql://sportsintel:replace-with-database-password@postgres:5432/sportsintel
POSTGRES_DB=sportsintel
POSTGRES_USER=sportsintel
POSTGRES_PASSWORD=replace-with-database-password
